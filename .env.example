# --------------------------------------------------------------------------- #
# Market Monitor — email delivery configuration
# --------------------------------------------------------------------------- #
# Copy this file to ".env" (same folder as run.py) and fill in real values.
# The ".env" file holds secrets — do NOT commit it to version control.
#
# Gmail requires an "App Password", not your normal password:
#   1. Turn on 2-Step Verification:  https://myaccount.google.com/security
#   2. Create an App Password:        https://myaccount.google.com/apppasswords
#      (choose app "Mail", device "Other" -> name it "Market Monitor")
#   3. Paste the generated 16-character password below, WITHOUT spaces.
# --------------------------------------------------------------------------- #

# The Gmail address you are sending FROM.
GMAIL_ADDRESS=youraddress@gmail.com

# The 16-character Gmail App Password (spaces removed).
GMAIL_APP_PASSWORD=your16charapppassword

# Who receives the report. Optional — defaults to GMAIL_ADDRESS (send to self).
EMAIL_RECIPIENT=recipient@example.com

# --------------------------------------------------------------------------- #
# GitHub Pages delivery
# --------------------------------------------------------------------------- #
# Public URL where the daily report is served (the "Open Full Report" button in
# the email links here). Replace YOUR_GITHUB_USERNAME with your GitHub handle.
# Leave unset to fall back to a local file:// link on this PC's Desktop.
GITHUB_PAGES_URL=https://YOUR_GITHUB_USERNAME.github.io/market-monitor/
